#!/usr/bin/env bash
# + -- --=[ Jarvis launcher — orchestration & reporting layer for Sn1per
#
# Thin shim so you can run ./jarvis-cli from the repo (or anywhere) without
# installing anything. It puts the repo root on PYTHONPATH and defers to the
# pure-stdlib Python package. No root required.

set -euo pipefail

# Resolve symlinks so the launcher finds the real install directory even when
# invoked via a symlink (install.sh registers /usr/bin/jarvis -> this script).
SOURCE="${BASH_SOURCE[0]}"
if command -v readlink >/dev/null 2>&1; then
  RESOLVED="$(readlink -f "$SOURCE" 2>/dev/null || true)"
  [ -n "$RESOLVED" ] && SOURCE="$RESOLVED"
fi
# Fallback manual resolution if readlink -f was unavailable.
while [ -L "$SOURCE" ]; do
  LINKDIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [ "${SOURCE#/}" = "$SOURCE" ] && SOURCE="$LINKDIR/$SOURCE"
done
DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PYTHON_BIN="${PYTHON_BIN:-python3}"

if ! command -v "$PYTHON_BIN" >/dev/null 2>&1; then
  echo "[!] python3 is required but was not found in PATH." >&2
  exit 1
fi

PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}" exec "$PYTHON_BIN" -m jarvis "$@"
