# Python bytecode / caches (Jarvis layer)
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Generated reports (keep test fixtures, ignore real output)
loot/workspace/*/reports/*-report.*
jarvis/tests/fixtures/**/reports/*-report.*

# Jarvis scheduled-run log
jarvis-cron.log

# Jarvis ASM snapshots (continuous-monitoring state, per workspace)
asm-snapshots/
