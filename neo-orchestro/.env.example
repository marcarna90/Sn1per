# Neo-Orchestro — configuration template.
# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real values.

# development | test | production. Unset = development for host runs; Docker Compose defaults to
# production. Leave commented unless you know why: production refuses insecure settings.
# NEO_ENV=development

# REQUIRED. >= 32 chars, random. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
NEO_SECRET_KEY=

# PostgreSQL (driver: pg8000). Replace CHANGE_ME.
NEO_DATABASE_URL=postgresql+pg8000://neo:CHANGE_ME@localhost:5432/neo_orchestro

# Redis (Celery broker + result backend). Replace CHANGE_ME.
NEO_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# Authentication
NEO_ACCESS_TOKEN_TTL_MINUTES=15
NEO_REFRESH_TOKEN_TTL_DAYS=7
NEO_LOGIN_MAX_FAILED_ATTEMPTS=5
NEO_LOGIN_LOCKOUT_MINUTES=15
# Must be true in production (HTTPS). Set false ONLY for plain-HTTP local development; it is
# commented out so that copying this file for Docker cannot weaken a production stack.
# NEO_COOKIE_SECURE=false

# Browser origins allowed to call the API cross-origin (comma-separated).
# Leave empty when the web UI is served same-origin (recommended).
NEO_CORS_ORIGINS=

# Observability
NEO_LOG_LEVEL=INFO
NEO_LOG_JSON=false
NEO_METRICS_ENABLED=true

# Scope engine limits (smallest CIDR prefix an organisation may authorise)
NEO_SCOPE_MIN_PREFIX_V4=16
NEO_SCOPE_MIN_PREFIX_V6=48

# Scan execution
NEO_SCAN_MAX_DURATION_SECONDS=900
NEO_DNS_TIMEOUT_SECONDS=5
# Comma-separated resolver IPs for scope validation and recon. Empty = the host's resolver.
# Point workers at a trusted resolver you control (ADR 0004).
NEO_DNS_NAMESERVERS=

# ---------------------------------------------------------------------------------------------
# Docker Compose (docker-compose.yml). These are required by `docker compose up`.
# ---------------------------------------------------------------------------------------------
# Strong random values, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Host port of the web UI (published on 127.0.0.1 only).
WEB_PORT=8080
# Local evaluation over plain HTTP only: set NEO_ENV=development and NEO_COOKIE_SECURE=false.
# Production keeps NEO_ENV=production and NEO_COOKIE_SECURE=true behind a TLS proxy.
# NEO_ENV=production
# NEO_COOKIE_SECURE=true
