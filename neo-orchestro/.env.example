# Neo-Orchestro — configuration template.
# Copy to `.env` and fill in. `.env` is git-ignored. Never commit real values.

# development | test | production
NEO_ENV=development

# REQUIRED. >= 32 chars, random. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
NEO_SECRET_KEY=

# PostgreSQL (driver: pg8000). Replace CHANGE_ME.
NEO_DATABASE_URL=postgresql+pg8000://neo:CHANGE_ME@localhost:5432/neo_orchestro

# Redis (Celery broker + result backend). Replace CHANGE_ME.
NEO_REDIS_URL=redis://:CHANGE_ME@localhost:6379/0

# Authentication
NEO_ACCESS_TOKEN_TTL_MINUTES=15
NEO_REFRESH_TOKEN_TTL_DAYS=7
NEO_LOGIN_MAX_FAILED_ATTEMPTS=5
NEO_LOGIN_LOCKOUT_MINUTES=15
# Must be true in production (HTTPS). false only for plain-HTTP local dev.
NEO_COOKIE_SECURE=false

# Browser origins allowed to call the API cross-origin (comma-separated).
# Leave empty when the web UI is served same-origin (recommended).
NEO_CORS_ORIGINS=

# Observability
NEO_LOG_LEVEL=INFO
NEO_LOG_JSON=false
NEO_METRICS_ENABLED=true

# Scope engine limits (smallest CIDR prefix an organisation may authorise)
NEO_SCOPE_MIN_PREFIX_V4=16
NEO_SCOPE_MIN_PREFIX_V6=48

# Scan execution
NEO_SCAN_MAX_DURATION_SECONDS=900
NEO_DNS_TIMEOUT_SECONDS=5
